{
  "framework": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/p1", "destination": "/index.html" },
    { "source": "/p2", "destination": "/index.html" },
    { "source": "/p3", "destination": "/index.html" },
    { "source": "/blackhole", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(index.html|blackhole.js|blackhole.css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/p(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=3600, stale-while-revalidate=86400" }
      ]
    }
  ]
}
